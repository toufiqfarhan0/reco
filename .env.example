# ==============================================================================
# RECO ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place live credentials in this template. Copy to .env for local runtime.
# ==============================================================================

# Model Provider: TensorMux (Track 1 Active Model)
TENSORMUX_API_KEY=tmx_your_api_key_here
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_MODEL=glm-4-7-flash

# Supporting Service: Observability (Neatlogs)
NEATLOGS_API_KEY=your_neatlogs_api_key_here
NEATLOGS_BASE_URL=https://ingest.neatlogs.com

# Supporting Service: Persistence (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Supporting Service: Billing (Dodo Payments)
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_secret_here
DODO_WEBHOOK_SECRET=whsec_your_dodo_webhook_secret_here
DODO_PAYMENTS_PRODUCT_ID=pdt_0Nmvzbo4wJETkRyCMAEPt

# Integration Flags (Active Integrations)
BILLING_ENABLED=true
OBSERVABILITY_ENABLED=true
